#: reports/templates/reports/map.html:7 reports/templates/reports/map.html:448
msgid "Карта доступности"
msgstr "Qulaylik xaritasi"

#: reports/templates/reports/map.html:449
msgid "Места, о которых сообщили жители через Telegram-бота"
msgstr "Aholi Telegram-bot orqali xabar bergan joylar"

#: reports/templates/reports/map.html:453
msgid "точек на карте"
msgstr "xaritadagi nuqtalar"

#: reports/templates/reports/map.html:457
msgid "Язык"
msgstr "Til"

#: reports/templates/reports/map.html:466
msgid "Категории"
msgstr "Toifalar"

#: reports/templates/reports/map.html:470
msgid "Нажмите, чтобы скрыть"
msgstr "Yashirish uchun bosing"

#: reports/templates/reports/map.html:475
msgid "Сообщить о месте"
msgstr "Joy haqida xabar berish"

#: reports/templates/reports/map.html:479
msgid "Как точка попадает на карту"
msgstr "Nuqta xaritaga qanday tushadi"

#: reports/templates/reports/map.html:480
msgid ""
"Откройте Telegram-бота, отправьте геолокацию и фото места без пандуса или "
"проезда. После проверки модератором точка появится на этой карте — её увидят "
"все, включая городские службы."
msgstr ""
"Telegram-botni oching, pandus yoki o‘tish joyi bo‘lmagan joyning "
"geolokatsiyasi va suratini yuboring. Moderator tekshirgach, nuqta shu "
"xaritada paydo bo‘ladi — uni hamma, shu jumladan shahar xizmatlari ham "
"ko‘radi."

#: reports/templates/reports/map.html:481
msgid "Понятно"
msgstr "Tushunarli"

#: reports/views.py:130
msgid "Загружаем точки…"
msgstr "Nuqtalar yuklanmoqda…"

#: reports/views.py:131
msgid ""
"Пока ни одной опубликованной точки. Отправьте место через бота — после "
"проверки оно появится здесь."
msgstr ""
"Hozircha e’lon qilingan nuqtalar yo‘q. Bot orqali joy yuboring — "
"tekshiruvdan so‘ng u shu yerda paydo bo‘ladi."

#: reports/views.py:133
msgid "Не удалось загрузить точки. Обновите страницу."
msgstr "Nuqtalarni yuklab bo‘lmadi. Sahifani yangilang."

#: reports/views.py:134
msgid "Фото не приложено"
msgstr "Surat biriktirilmagan"

#: reports/views.py:135
msgid "Фото недоступно"
msgstr "Surat mavjud emas"

#: reports/views.py:136
msgid "Сообщено"
msgstr "Xabar berilgan"

#: reports/views.py:137
msgid "Устранено"
msgstr "Bartaraf etilgan"
