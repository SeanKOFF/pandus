# Caddy сам получает и продлевает сертификат Let's Encrypt для DOMAIN,
# и сам редиректит http → https. Certbot не нужен.

{$DOMAIN} {
	encode gzip

	# Ограничение на размер загрузки — защита от заваливания диска
	request_body {
		max_size 15MB
	}

	reverse_proxy web:8000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}
